; Async tests of Cobalt_ui.Vcs_host, the frontend's runner for registered views' jobs:
; a real Cobalt_vcs_host runner against git in isolated fixture repositories
; (Cobalt_vcs_fixture.Fixture_repo) and small /bin/sh children. Never the Cobalt
; repository, never a network; every host is shut down and every child reaped.

(library
 (name cobalt_ui_vcs_test)
 (libraries cobalt_ui cobalt_screen cobalt_vcs cobalt_vcs_git cobalt_vcs_host
  cobalt_vcs_fixture core core_unix core_unix.signal_unix async)
 ; See core/dune for why this flag is needed.
 (inline_tests
  (flags
   (:standard -source-tree-root .)))
 (preprocess
  (pps ppx_jane)))
