; cobalt_ui is the Bonsai_term frontend: it adapts terminal events, runs the
; cobalt_screen transition in one state machine, and draws cobalt_screen's frames. It also
; connects a cobalt_source diagnostic source to that state machine, and runs the jobs
; registered views submit (the VCS view's git commands) on one cobalt_vcs_host runner.

(library
 (name cobalt_ui)
 (libraries cobalt_harness cobalt_navigation_preview_model cobalt_error cobalt_config_runtime cobalt_completion cobalt_terminal cobalt_terminal_host cobalt_theme cobalt_app cobalt_core cobalt_input cobalt_screen cobalt_source cobalt_tile cobalt_file_picker cobalt_file_preview cobalt_file_picker_host cobalt_line_picker cobalt_content_picker cobalt_content_picker_host cobalt_vcs cobalt_vcs_host core async base64 bonsai bonsai_term)
 (preprocess
  (pps ppx_jane bonsai.ppx_bonsai)))
