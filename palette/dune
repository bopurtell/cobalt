; cobalt_palette is the command palette backend: the command catalog, fuzzy matching,
; and shortcut hints. Like cobalt_input it must never depend on bonsai, bonsai_term,
; async, notty, or any terminal library, nor on cobalt_app or cobalt_screen: execution
; and presentation belong to the integration that hosts the palette.

(library
 (name cobalt_palette)
 (libraries cobalt_core cobalt_input core)
 (preprocess
  (pps ppx_jane)))
