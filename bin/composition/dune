; This is the only concrete provider dependency outside markdown/. Removing that
; complete subtree selects the stub, without any native Markdown build inputs.
(library
 (name cobalt_document_decorations)
 (libraries cobalt_ui
  (select provider_adapter.ml from
   (cobalt_markdown -> provider_adapter.enabled.ml)
   (-> provider_adapter.disabled.ml))))

; Removing silver_overview/ selects the unavailable composition, without pulling
; Silver protocol or transport into the editor libraries.
(library
 (name cobalt_silver_composition)
 (libraries cobalt_ui cobalt_screen core async
  (select silver_adapter.ml from
   (cobalt_silver_overview -> silver_adapter.enabled.ml)
    (-> silver_adapter.disabled.ml))
    (select stage_projection.ml from
     (cobalt_silver_overview -> stage_projection.enabled.ml)
     (-> stage_projection.disabled.ml))
    (select silver_kickoff_adapter.ml from
    (cobalt_silver_overview -> silver_kickoff_adapter.enabled.ml)
    (-> silver_kickoff_adapter.disabled.ml)))
 (preprocess (pps ppx_jane)))
