(executable
 (name cobalt)
 (public_name cobalt)
 (modules cobalt)
 (libraries cobalt_cli cobalt_document_decorations cobalt_silver_composition))

(executable
 (name cobalt_no_provider)
 (modules cobalt_no_provider)
 (libraries cobalt_cli cobalt_ui))

(rule
 (alias runtest)
 (deps test_configuration_cli.py)
 (locks /smoke)
 (action (run python3 %{dep:test_configuration_cli.py} %{exe:cobalt.exe})))

(rule
 (alias runtest)
 (deps test_harness_cli.py)
 (locks /smoke)
  (action (run python3 %{dep:test_harness_cli.py} %{exe:cobalt.exe})))

(rule
 (alias runtest)
 (deps test_no_provider_cli.py)
 (locks /smoke)
 (action (run python3 %{dep:test_no_provider_cli.py} %{exe:cobalt_no_provider.exe})))

(rule
 (alias runtest)
 (deps test_main_editor_cli.py)
 (locks /smoke)
 (action
  (run python3 %{dep:test_main_editor_cli.py}
   %{exe:cobalt.exe} %{exe:../main_editor_sender/cobalt_open.exe})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:cobalt_silver_overview})
 (deps test_silver_cli.py)
 (locks /smoke)
 (action
  (run python3 %{dep:test_silver_cli.py}
   %{exe:cobalt.exe} %{exe:cobalt_no_provider.exe})))

(rule
 (alias runtest)
 (enabled_if %{lib-available:cobalt_silver_overview})
 (deps
  test_silver_cli.py
  test_silver_quick_launch_cli.py
  ../examples/silver_overview/wire/c6-catalog.json
  ../examples/silver_overview/wire/c6-launch.json)
 (locks /smoke)
 (action
  (run python3 -B %{dep:test_silver_quick_launch_cli.py}
   %{exe:cobalt.exe} ../examples/silver_overview/wire)))
