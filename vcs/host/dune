; cobalt_vcs_host runs cobalt_vcs jobs as child processes under Async: the mutation
; queue, concurrent reads, streaming output, timeouts, cancellation, and the
; non-interactive authentication environment. Like cobalt_source it must not depend on
; cobalt_screen, cobalt_ui or any terminal library; cobalt_ui connects it to the UI state.

(library
 (name cobalt_vcs_host)
 (libraries cobalt_vcs core core_unix core_unix.signal_unix async)
 (preprocess
  (pps ppx_jane)))
