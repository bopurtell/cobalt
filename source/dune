; cobalt_source runs diagnostic sources: the asynchronous side of the boundary in
; Cobalt_error.Source_event / Source_request. It owns timers, processes, and the
; language-server session. It must not depend on cobalt_screen, cobalt_ui, bonsai,
; or any terminal library; cobalt_ui wires it into the UI state. Unlike cobalt_core,
; cobalt_input, cobalt_app, and cobalt_error, it may use Async. cobalt_core supplies the
; cell layout that turns protocol positions into display columns; lsp and jsonrpc
; (from the ocaml-lsp repository) are the protocol's types and framing only.

(library
 (name cobalt_source)
  (libraries cobalt_error cobalt_completion cobalt_core cobalt_highlight core core_unix core_unix.filename_unix core_unix.sys_unix async lsp jsonrpc)
 (preprocess
  (pps ppx_jane)))
