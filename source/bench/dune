; Typing latency under a synthetic diagnostic burst. Not installed; run with
; dune exec source/bench/latency.exe.

(executable
 (name latency)
 (modules latency)
 (libraries cobalt_source cobalt_error cobalt_screen cobalt_app cobalt_core cobalt_input core
  core_unix core_unix.time_ns_unix)
 (preprocess
  (pps ppx_jane)))

