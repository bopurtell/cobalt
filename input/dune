; cobalt_input turns normalized key events into editor commands. Like cobalt_core it
; must never depend on bonsai, bonsai_term, async, notty, or any terminal library;
; the UI adapter converts terminal events into [Key.t] and [Keymap.Input.t].

(library
 (name cobalt_input)
 (libraries cobalt_core core)
 (preprocess
  (pps ppx_jane)))
